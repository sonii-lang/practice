import java.util.Scanner;

public class Square {

    static int square(int num) {
        return num * num;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a number: ");
        int num = sc.nextInt();

        System.out.println("Square = " + square(num));

        sc.close();
    }
}
